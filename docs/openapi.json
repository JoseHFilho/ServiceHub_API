{"openapi":"3.1.0","info":{"title":"ServiceHub API","description":"API acadêmica de gerenciamento de usuários. CRUD com PostgreSQL, validações e respostas de erro padronizadas. Esta etapa não implementa autenticação.","contact":{"name":"Projeto ServiceHub","url":"https://github.com/JoseHFilho/ServiceHub_API"},"version":"1.0.0"},"servers":[{"url":"http://localhost:8080","description":"Generated server url"}],"tags":[{"name":"Aplicação","description":"Rotas de identificação e disponibilidade do ServiceHub."},{"name":"Monitoramento","description":"Disponibilidade da aplicação e do banco de dados."},{"name":"Usuários","description":"Cadastro e manutenção de usuários do ServiceHub."}],"paths":{"/api/users/{id}":{"get":{"tags":["Usuários"],"summary":"Buscar usuário por ID","description":"Retorna os dados públicos do usuário. Retorna 404 quando o identificador não existe.","operationId":"findById","parameters":[{"name":"id","in":"path","description":"ID do usuário","required":true,"schema":{"type":"integer","format":"int64"},"example":1}],"responses":{"200":{"description":"Usuário encontrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"404":{"description":"Usuário não encontrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"400":{"description":"Dados ou identificador inválidos","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}},"put":{"tags":["Usuários"],"summary":"Substituir dados do usuário","description":"Substitui nome, e-mail e senha. Os três campos são obrigatórios. O ID e a data de criação são preservados. Para alterar apenas alguns campos, use PATCH.","operationId":"update","parameters":[{"name":"id","in":"path","description":"ID do usuário","required":true,"schema":{"type":"integer","format":"int64"},"example":1}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserDTO"}}},"required":true},"responses":{"200":{"description":"Usuário atualizado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"404":{"description":"Usuário não encontrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"409":{"description":"E-mail pertence a outro usuário","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"415":{"description":"Envie o corpo como application/json","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"400":{"description":"Dados ou identificador inválidos","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}},"delete":{"tags":["Usuários"],"summary":"Excluir usuário","description":"Remove um usuário existente. A resposta de sucesso não tem corpo. Vínculos que impeçam a exclusão retornam 409.","operationId":"delete","parameters":[{"name":"id","in":"path","description":"ID do usuário","required":true,"schema":{"type":"integer","format":"int64"},"example":1}],"responses":{"204":{"description":"Usuário excluído"},"404":{"description":"Usuário não encontrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"409":{"description":"Usuário possui dados vinculados que impedem a exclusão","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"400":{"description":"Dados ou identificador inválidos","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}},"patch":{"tags":["Usuários"],"summary":"Atualizar parcialmente o usuário","description":"Altera os campos informados e não nulos, preservando os demais. Exige ao menos um campo e rejeita valores em branco.","operationId":"patch","parameters":[{"name":"id","in":"path","description":"ID do usuário","required":true,"schema":{"type":"integer","format":"int64"},"example":1}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserPatchDTO"}}},"required":true},"responses":{"200":{"description":"Usuário atualizado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"404":{"description":"Usuário não encontrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"409":{"description":"E-mail pertence a outro usuário","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"415":{"description":"Envie o corpo como application/json","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"400":{"description":"Dados ou identificador inválidos","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}}},"/api/users":{"get":{"tags":["Usuários"],"summary":"Listar usuários","description":"Retorna todos os usuários cadastrados em um array. Retorna um array vazio quando não há registros.","operationId":"findAll","responses":{"200":{"description":"Lista de usuários","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/UserResponse"}}}}},"400":{"description":"Dados ou identificador inválidos","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}},"post":{"tags":["Usuários"],"summary":"Criar usuário","description":"Cadastra um usuário com nome, e-mail único e senha. Normaliza o e-mail e armazena somente o hash da senha.","operationId":"create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserDTO"}}},"required":true},"responses":{"201":{"description":"Usuário criado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}},"409":{"description":"E-mail já cadastrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"415":{"description":"Envie o corpo como application/json","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"400":{"description":"Dados ou identificador inválidos","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}}},"/api/status":{"get":{"tags":["Aplicação"],"summary":"Consultar status da aplicação","description":"Retorna o status e a versão da API em JSON. A saúde do banco pode ser consultada em /actuator/health.","operationId":"status","responses":{"200":{"description":"Aplicação disponível","content":{"*/*":{"schema":{"$ref":"#/components/schemas/StatusResponse"}}}}}}},"/api/hello":{"get":{"tags":["Aplicação"],"summary":"Consultar mensagem inicial","description":"Retorna a identificação da aplicação em JSON, com uma mensagem de boas-vindas.","operationId":"hello","responses":{"200":{"description":"Aplicação disponível","content":{"*/*":{"schema":{"$ref":"#/components/schemas/StatusResponse"}}}}}}},"/actuator":{"get":{"tags":["Monitoramento"],"summary":"Consultar links de monitoramento","description":"Lista os links dos endpoints de monitoramento habilitados na aplicação.","operationId":"links","responses":{"200":{"description":"OK","content":{"application/vnd.spring-boot.actuator.v3+json":{"schema":{"type":"object","additionalProperties":{"type":"object","additionalProperties":{"$ref":"#/components/schemas/Link"}}}},"application/vnd.spring-boot.actuator.v2+json":{"schema":{"type":"object","additionalProperties":{"type":"object","additionalProperties":{"$ref":"#/components/schemas/Link"}}}},"application/json":{"schema":{"type":"object","additionalProperties":{"type":"object","additionalProperties":{"$ref":"#/components/schemas/Link"}}}}}}}}},"/actuator/health":{"get":{"tags":["Monitoramento"],"summary":"Consultar saúde da aplicação","description":"Verifica a disponibilidade da aplicação e do banco de dados. Retorna 200 quando saudável ou 503 quando indisponível.","operationId":"health","responses":{"200":{"description":"OK","content":{"application/vnd.spring-boot.actuator.v3+json":{"schema":{"type":"object"}},"application/vnd.spring-boot.actuator.v2+json":{"schema":{"type":"object"}},"application/json":{"schema":{"type":"object"}}}},"503":{"description":"Aplicação ou banco indisponível"}}}}},"components":{"schemas":{"UserDTO":{"type":"object","description":"Dados completos para criar ou substituir um usuário. Todos os campos são obrigatórios.","properties":{"fullName":{"type":"string","description":"Nome completo","example":"Maria Silva","maxLength":100},"email":{"type":"string","format":"email","description":"E-mail único, normalizado para minúsculas e sem espaços externos.","example":"maria@servicehub.com","maxLength":255},"password":{"type":"string","format":"password","description":"Senha obrigatória e não vazia. Armazenada como hash e nunca retornada.","example":"senha123","writeOnly":true}},"required":["email","fullName","password"]},"ApiError":{"type":"object","description":"Resposta de erro padronizada da API.","properties":{"timestamp":{"type":"string","format":"date-time","description":"Data e hora do erro","example":"2026-09-22T10:00:00"},"status":{"type":"integer","format":"int32","description":"Código HTTP","example":404},"error":{"type":"string","description":"Descrição do status HTTP","example":"Not Found"},"message":{"type":"string","description":"Mensagem explicativa","example":"Usuário não encontrado: 42"},"path":{"type":"string","description":"Caminho da requisição","example":"/api/users/42"}}},"UserResponse":{"type":"object","description":"Dados públicos do usuário. Não inclui senha nem hash.","properties":{"id":{"type":"integer","format":"int64","description":"Identificador gerado pelo banco","example":1},"fullName":{"type":"string","description":"Nome completo","example":"Maria Silva"},"email":{"type":"string","description":"E-mail normalizado","example":"maria@servicehub.com"},"createdAt":{"type":"string","format":"date-time","description":"Data e hora de criação","example":"2026-09-22T10:00:00"}}},"UserPatchDTO":{"type":"object","description":"Atualização parcial. Informe ao menos um campo não nulo. Campos omitidos ou nulos são preservados; valores em branco são rejeitados.","properties":{"fullName":{"type":"string","description":"Novo nome completo","example":"Maria Souza","maxLength":100},"email":{"type":"string","format":"email","description":"Novo e-mail único","example":"maria.souza@servicehub.com","maxLength":255},"password":{"type":"string","format":"password","description":"Nova senha","example":"nova-senha123","writeOnly":true}}},"StatusResponse":{"type":"object","description":"Identificação da aplicação. Para verificar também o banco, consulte /actuator/health.","properties":{"status":{"type":"string","description":"Estado da aplicação","example":"OK"},"version":{"type":"string","description":"Versão da API","example":"1.0.0"},"message":{"type":"string","description":"Mensagem da aplicação","example":"ServiceHub API está no ar! 🚀"}}},"Link":{"type":"object","properties":{"href":{"type":"string"},"templated":{"type":"boolean"}}}}}}