# Rode scripts/prepare-env.ps1 para gerar um .env local sem imprimir os segredos.
# Use outro nome de projeto/volume para instalações novas. Não versione seu .env.
COMPOSE_PROJECT_NAME=servicehub-stack
SERVICEHUB_IMAGE=servicehub-api:java25
POSTGRES_MAJOR=15
DB_NAME=servicehub
DB_ADMIN_USERNAME=servicehub_admin
DB_ADMIN_PASSWORD=
DB_MIGRATION_USERNAME=servicehub_migrator
DB_MIGRATION_PASSWORD=
DB_USERNAME=servicehub_app
DB_PASSWORD=
SPRING_PROFILES_ACTIVE=prod
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080
SERVER_PORT=8080
# Só é usado quando compose.host-db.yaml é informado explicitamente.
POSTGRES_PORT=55433
JWT_SECRET=
JWT_TTL=15m
JWT_ISSUER=servicehub-api
