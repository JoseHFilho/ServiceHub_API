{
    admin off
    http_port 8080
    https_port 8443
    auto_https disable_redirects
    skip_install_trust
    servers {
        strict_sni_host on
        max_header_size 16KB
        timeouts {
            read_header 10s
            read_body 15s
            write 30s
            idle 60s
        }
    }
}
import /etc/caddy/common.caddy
https://{$PUBLIC_DOMAIN}:8443 {
    tls internal {
        protocols tls1.2 tls1.3
    }
    import servicehub_api
}
